# Production Environment Configuration for WeatherOps on Render
# Copy this file to .env.production and fill in the values

# Application Configuration
APP_NAME=WeatherOps
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
RELOAD=False

# Security
SECRET_KEY=your-production-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (PostgreSQL - Render managed)
# Format: postgresql://user:password@host:port/database
# Render will provide this via DATABASE_URL environment variable
# DATABASE_URL will be injected by Render from the managed database

# Redis (Render managed)
# Render will provide this via REDIS_URL environment variable
# REDIS_URL will be injected by Render from the managed Redis instance

# Celery Configuration
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=True
CELERY_TASK_TIME_LIMIT=1800

# WeatherAI Integration
WEATHERAI_BASE_URL=https://api.weatherai.com
WEATHERAI_API_KEY=your-weatherai-api-key

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Twilio SMS (Optional - for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# SendGrid Email (Optional - for email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Database Pool Settings (for PostgreSQL)
DATABASE_ECHO=False
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_PRE_PING=True
